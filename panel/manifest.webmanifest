  "orientation": "any",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/panel/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/panel/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/panel/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Teklifler", "short_name": "Teklifler", "url": "/panel/teklifler/" },
    { "name": "Projeler", "short_name": "Projeler", "url": "/panel/projeler/" },
    { "name": "Başvurular", "short_name": "Başvurular", "url": "/panel/basvurular/" }
  ]
}
