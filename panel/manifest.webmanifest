{
  "name": "Roy Panel",
  "short_name": "Roy",
  "description": "Roy Labs iç yönetim paneli: teklifler, projeler, başvurular ve ekip.",
  "id": "/panel/",
  "start_url": "/panel/",
  "scope": "/panel/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0C0C0D",
